# Public site origin used for canonical URLs, Open Graph, and sitemap references.
VITE_SITE_URL=https://gauravnagarkoti.tech

# Contact API — Cloudflare Pages Function (same origin). Override only if needed.
VITE_CONTACT_ENDPOINT=/api/contact

# Optional HTTPS Calendly (or equivalent) URL for the Schedule Call button.
# VITE_CALENDLY_URL=https://calendly.com/your-org/discovery

# Social profile URLs are set in src/data/site.js → BRAND.profiles (not env).
# Fill linkedin / github / x, then redeploy so sameAs + footer update.

# Logging: debug | info | warn | error
VITE_LOG_LEVEL=info

# Local Vite → API proxy target (Express :8787 or wrangler pages :8788)
# VITE_API_PROXY=http://127.0.0.1:8787
