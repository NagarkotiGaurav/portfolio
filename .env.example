# Public site origin used for canonical URLs, Open Graph, and sitemap references.
VITE_SITE_URL=https://gauravnagarkoti.tech

# Contact delivery: point at the contact API once deployed (Telegram + Sheets).
# Secrets stay on the API — never put bot tokens in VITE_ vars.
# VITE_CONTACT_ENDPOINT=http://localhost:8787/api/contact
# VITE_CONTACT_ENDPOINT=https://portfolio-contact-api.onrender.com/api/contact
#
# Fallback when endpoint is unset: FormSubmit → email only.
VITE_CONTACT_EMAIL=gauravnagarkoti08@gmail.com

# Optional HTTPS Calendly (or equivalent) URL for the Schedule Call button.
# VITE_CALENDLY_URL=https://calendly.com/your-org/discovery

# Logging: debug | info | warn | error
VITE_LOG_LEVEL=info
