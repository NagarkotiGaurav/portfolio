# Copy to .env for local runs (never commit real tokens).
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info

# Telegram — leave empty until ready; set ENABLED=true and credentials to activate
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets — leave empty until ready; set ENABLED=true and webhook to activate
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
